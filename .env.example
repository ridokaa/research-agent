# App
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json
LOG_FILE=./logs/agent.jsonl

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# LLM (responses | chat_completions)
LLM_API_STYLE=responses       # responses | chat_completions (mis. 9Router / DeepSeek)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_STORE=true              # simpan state di server OpenAI → pakai previous_response_id
LLM_REASONING_EFFORT=       # isi (low/medium/high) hanya untuk model reasoning; kosongkan bila tidak

# Agent loop
AGENT_MAX_ITERATIONS=8
AGENT_RUN_TIMEOUT_S=180
AGENT_CREDITS_BUDGET=100
AGENT_PARALLEL_TOOLS=true

# Verosight
VEROSIGHT_API_BASE=https://api.verosight.com
VEROSIGHT_API_KEY=vlt_live_xxx
VEROSIGHT_MCP_SSE_URL=https://api.verosight.com/v1/mcp/sse
VEROSIGHT_ENABLED=true
VEROSIGHT_MODE=mcp          # rest | mcp | both

